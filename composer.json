{
  "name": "codeigniter/project",
  "description": "CodeIgniter Application",
  "type": "project",
  "require": {
    "php": ">=7.4",
    "phpunit/phpunit": "^9.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist"
  }
}
