pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'develop', url: 'https://github.com/ihyaasrfyy/CodeIgniter.git'
            }
        }

        stage('Install Dependencies') {
            environment {
                PATH = "C:\\xampp\\php;C:\\composer;${env.PATH}"
            }
            steps {
                bat 'composer install --no-dev --optimize-autoloader'
            }
        }

        stage('Run Tests') {
            steps {
                bat 'phpunit --configuration phpunit.xml'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application...'
                // Tambahkan perintah deploy kalau ada
            }
        }
    }

    post {
        failure {
            echo 'Pipeline failed!'
        }
    }
}
