pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'develop', url: 'https://github.com/ihyaasrfyy/CodeIgniter.git'
            }
        }

        stage('Install Dependencies') {
            environment {
                PATH = "C:\\composer;${env.PATH}"
            }
            steps {
                bat 'composer install --no-dev --optimize-autoloader'
            }
        }

        stage('Run Tests') {
            steps {
                bat 'vendor\\bin\\phpunit'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploy tahap akhir di sini...'
            }
        }
    }

    post {
        failure {
            echo 'Pipeline failed!'
        }
        success {
            echo 'Pipeline succeeded!'
        }
    }
}
